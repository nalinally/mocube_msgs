# 赤外線受信器 1 つ分の隣接情報

string face          # 面の名前 "u" / "r" / "f" (= ファームの受信チャンネル 0 / 1 / 2)
int32 address        # 最後に受けたビーコンの送信元モジュール ID
                     #   -1  : まだ一度も受信していない
                     #   255 : 送信元が ID 未取得 (ファームの -1 が uint8 になったもの)
float64 t            # 最後に受信した時刻 (UNIX time [s])。未受信なら 0
                     # ※ 古い値も消えずに残るので、隣接が今も続いているかは t で判断する
